{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "prepush-force": "node -e \"const Database = require('better-sqlite3'); const db = new Database(process.env.DATABASE_URL || 'sqlite.db'); try { db.exec('DROP INDEX IF EXISTS vouchers_code_unique'); } catch (e) {}\"",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.10"
  }
}
